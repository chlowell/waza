#!/bin/bash
set -euo pipefail

# Install waza into the container.
# If waza is already available (e.g. pre-installed in the Dockerfile), skip download.

if command -v waza &> /dev/null; then
    echo "waza already installed: $(waza --version)"
    exit 0
fi

# Install curl if not available
if command -v apt-get &> /dev/null; then
    apt-get update -qq
    apt-get install -y -qq curl ca-certificates > /dev/null
elif command -v apk &> /dev/null; then
    apk add --no-cache curl ca-certificates
fi

# Download waza binary from GitHub releases
ARCH=$(uname -m)
case "$ARCH" in
    x86_64)  ARCH="amd64" ;;
    aarch64) ARCH="arm64" ;;
esac

OS=$(uname -s | tr '[:upper:]' '[:lower:]')

{% if version %}
VERSION="{{ version }}"
{% else %}
VERSION="latest"
{% endif %}

if [ "$VERSION" = "latest" ]; then
    URL="https://github.com/microsoft/waza/releases/latest/download/waza-${OS}-${ARCH}"
else
    URL="https://github.com/microsoft/waza/releases/download/${VERSION}/waza-${OS}-${ARCH}"
fi

echo "Downloading waza from ${URL}"
curl -fsSL -o /usr/local/bin/waza "$URL" || {
    echo "Failed to download waza. Ensure the binary is available at ${URL}"
    exit 1
}
chmod +x /usr/local/bin/waza
waza --version
